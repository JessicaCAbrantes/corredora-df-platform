# API (NestJS) — copy to apps/api/.env (never commit real values).
# Full reference: docs/setup/environment.md

PORT=3001
NODE_ENV=development

# Local Docker Compose maps host 5433 → container 5432 (see infrastructure/docker-compose.yml).
# CI uses localhost:5432 directly. Adjust the port to match your Postgres.
DATABASE_URL=postgresql://corredora:corredora@localhost:5433/corredora_df?schema=public

# Web origin allowed by CORS (apps/web default is http://localhost:3000).
CORS_ORIGIN=http://localhost:3000

# Required — HMAC secret for corredora_session cookie.
# Boot fails if AUTH_SECRET is missing or blank.
# Generate e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-change-me-use-a-long-random-string

# Payments (Kit Pickup Request) — fail-closed at bootstrap (FASE 3.4-B)
# Local/CI: PAYMENT_PROVIDER=mock. Do NOT set STRIPE_* with mock (boot fails).
# Production (NODE_ENV=production): mock is forbidden; use stripe + both secrets.
PAYMENT_PROVIDER=mock
PUBLIC_API_BASE_URL=http://localhost:3001
PAYMENT_SUCCESS_URL=http://localhost:3000/kit-pickup-requests/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/kit-pickup-requests/payment/cancel
# Optional for mock — defaults derived from AUTH_SECRET when omitted
# PAYMENT_WEBHOOK_SECRET=
# Stripe (required when PAYMENT_PROVIDER=stripe; leave unset for mock)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Kit Pickup Operations — comma-separated User.id allowlist (MVP, not RBAC).
# After `pnpm prisma:seed`, include usr_seed_runner (or GET /auth/me after login).
KIT_PICKUP_OPERATOR_USER_IDS=usr_seed_runner

# Seed is for local/CI only. Production is blocked unless you set:
# ALLOW_DB_SEED=true
# See docs/database/seeding.md
