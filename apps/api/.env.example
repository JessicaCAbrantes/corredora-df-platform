PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://corredora:corredora@localhost:5432/corredora_df?schema=public
CORS_ORIGIN=http://localhost:3000
# Required — HMAC secret for corredora_session cookie.
# Copy this file to apps/api/.env and replace with a long random string (never commit .env).
# Boot fails if AUTH_SECRET is missing or blank. Generate e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-change-me-use-a-long-random-string

# Payments (Kit Pickup Request Phase 2)
# Default local/CI: mock HMAC gateway. Production: PAYMENT_PROVIDER=stripe + Stripe keys.
PAYMENT_PROVIDER=mock
PUBLIC_API_BASE_URL=http://localhost:3001
PAYMENT_SUCCESS_URL=http://localhost:3000/kit-pickup-requests/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/kit-pickup-requests/payment/cancel
# Optional for mock — defaults derived from AUTH_SECRET when omitted
# PAYMENT_WEBHOOK_SECRET=
# Stripe (required when PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
