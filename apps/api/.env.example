PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://corredora:corredora@localhost:5432/corredora_df?schema=public
CORS_ORIGIN=http://localhost:3000
# Required — HMAC secret for corredora_session cookie.
# Copy this file to apps/api/.env and replace with a long random string (never commit .env).
# Boot fails if AUTH_SECRET is missing or blank. Generate e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-change-me-use-a-long-random-string
